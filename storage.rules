rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Covers are public for readers, but writable ONLY by the authoritative single admin
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == '54WZPYBFR8VIPv9qpIDn1FI0bcz1';
    }
    // All other paths strictly denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
